{
  "name": "tech-knowledge-graph",
  "version": "1.0.0",
  "description": "Agent-agnostic self-healing knowledge graph ecosystem for engineering teams",
  "main": "web/server.js",
  "scripts": {
    "start": "node web/server.js",
    "analyze:repo": "node skills/repo-analyzer/scripts/analyze-repo.js",
    "mcp": "node mcp-server/index.js",
    "index:vectors": "node mcp-server/vector-indexer.js",
    "lint": "node skills/knowledge-linter/scripts/validate.js",
    "fix": "node skills/knowledge-fixer/scripts/fix.js --create-stubs",
    "compile": "node skills/knowledge-governance/scripts/compile-graph.js",
    "audit": "node skills/knowledge-governance/scripts/audit-gaps.js",
    "analyze": "node skills/knowledge-orchestrator/scripts/analyze-intake.js",
    "ingest": "node skills/knowledge-orchestrator/scripts/ingest.js",
    "export:teams": "node skills/knowledge-governance/scripts/export-for-teams.js",
    "squad:setup": "node scripts/squad-setup.js",
    "sync:standards": "node skills/standards-extractor/scripts/extract-vscode-standards.js",
    "squad:war-room": "node scripts/squad-terminal.js --spawn-terminals",
    "squad:simulate": "node scripts/squad-terminal.js --simulate",
    "squad:dev-start": "node scripts/squad-terminal.js --trigger READY_FOR_DEV",
    "squad:dev-done": "node scripts/squad-terminal.js --trigger READY_FOR_VALIDATION",
    "qa:xray": "node skills/squad-qa/scripts/xray-exporter.js"
  },
  "keywords": [
    "knowledge-graph",
    "code-analysis",
    "repo-analyzer",
    "reverse-engineering",
    "agent",
    "obsidian",
    "tech-lead"
  ],
  "author": "gabrielfribeiro",
  "license": "MIT"
}
