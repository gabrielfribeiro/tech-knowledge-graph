{
  "name": "tech-knowledge-graph",
  "version": "1.0.0",
  "description": "Agent-agnostic self-healing knowledge graph ecosystem for engineering teams",
  "main": "web/server.js",
  "scripts": {
    "start": "node web/server.js",
    "mcp": "node mcp-server/index.js",
    "index:vectors": "node mcp-server/vector-indexer.js",
    "lint": "node skills/knowledge-linter/scripts/validate.js",
    "fix": "node skills/knowledge-fixer/scripts/fix.js --create-stubs",
    "compile": "node skills/knowledge-governance/scripts/compile-graph.js",
    "audit": "node skills/knowledge-governance/scripts/audit-gaps.js",
    "analyze": "node skills/knowledge-orchestrator/scripts/analyze-intake.js",
    "ingest": "node skills/knowledge-orchestrator/scripts/ingest.js",
    "export:teams": "node skills/knowledge-governance/scripts/export-for-teams.js"
  },
  "keywords": [
    "knowledge-graph",
    "mcp",
    "model-context-protocol",
    "vector-search",
    "embeddings",
    "graphrag",
    "agent",
    "obsidian",
    "tech-lead"
  ],
